+// Keep the UI model stable while using nats.go's explicit JSON wire names.
+function encode(bucket: BucketConfig) {
+    const { maxBytes, maxValueSize, replicas, ...rest } = bucket
+    return { ...rest, max_bytes: maxBytes, max_value_size: maxValueSize, num_replicas: replicas }
+}
+
+function decode(state: any): BucketState {
+    if (!state) return state
+    const config = state.config
+    return {
+        ...state,
+        backingStore: state.backing_store,
+        config: config ? {
+            ...config,
+            maxBytes: config.max_bytes,
+            maxValueSize: config.max_value_size,
+            replicas: config.num_replicas,
+        } : undefined,
+    }
+}
+
 /** INDEX */
 function index(connectionId: string, opt?: CallOptions): Promise<BucketState[]> {
-	return ajax.get(`connection/${connectionId}/kv`, null, opt)
+	return ajax.get(`connection/${connectionId}/kv`, null, opt).then(states => (states ?? []).map(decode))
 }
 
